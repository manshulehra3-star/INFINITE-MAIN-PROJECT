# ═══════════════════════════════════════════════
#  INFINITECORE BOT — ENV TEMPLATE
#  Copy this to .env and fill your values
#  ═══════════════════════════════════════════════

# ── Bot Identity ──
BOT_NAME=InfiniteCore
BOT_VERSION=4.0.0
BOT_PREFIX=!
BOT_ACTIVITY=InfiniteCore • Premium Hosting
BOT_STATUS=online
BOT_FOOTER_TEXT=InfiniteCore • Premium Services
BOT_THUMBNAIL_URL=
BOT_BANNER_URL=

# ── Colors ──
COLOR_PRIMARY=0x5865F2
COLOR_SUCCESS=0x57F287
COLOR_WARNING=0xFEE75C
COLOR_ERROR=0xED4245
COLOR_INFO=0x00B0F4
COLOR_PREMIUM=0xFFD700

# ── Discord ──
DISCORD_TOKEN=
GUILD_ID=0
OWNER_ID=0
DEVELOPER_IDS=

# ── Roles ──
ADMIN_ROLE_IDS=
STAFF_ROLE_IDS=
SUPPORT_ROLE_IDS=
MODERATOR_ROLE_IDS=
VERIFIED_ROLE_ID=0
MUTED_ROLE_ID=0
AUTO_ROLL_ROLE_ID=0

# ── Channels ──
TICKET_CATEGORY_ID=0
TICKET_LOG_CHANNEL_ID=0
TICKET_TRANSCRIPT_CHANNEL_ID=0
TICKET_FEEDBACK_CHANNEL_ID=0
PAYMENT_LOG_CHANNEL_ID=0
WELCOME_CHANNEL_ID=0
GOODBYE_CHANNEL_ID=0
ANNOUNCEMENT_CHANNEL_ID=0
VPS_LOG_CHANNEL_ID=0
MOD_LOG_CHANNEL_ID=0
MESSAGE_LOG_CHANNEL_ID=0
VOICE_LOG_CHANNEL_ID=0
ROLE_LOG_CHANNEL_ID=0
SERVER_LOG_CHANNEL_ID=0
ERROR_LOG_CHANNEL_ID=0
SUGGESTION_CHANNEL_ID=0
LEVEL_UP_CHANNEL_ID=0

# ── Tickets ──
TICKET_PREFIX=ticket
MAX_TICKETS_PER_USER=3
TICKET_TRANSCRIPT_ENABLED=true
TICKET_TRANSCRIPT_FORMAT=html
TICKET_AUTO_CLOSE_HOURS=48
TICKET_PING_STAFF=true
TICKET_RATING_ENABLED=true
TICKET_ESCALATION_ENABLED=true
TICKET_ESCALATION_MINUTES=60
TICKET_AI_GREETING=true
TICKET_AI_SUMMARY=true
TICKET_QUICK_REPLIES=Please wait|Share UTR|Under review|Thanks for patience

# ═══════════════════════════════════════════════
#  🤖 AI CONFIGURATION — FASTEST VERSION
#  ─────────────────────────────────────────────
#  Recommended: qwen3:0.6b
#    • Size: 523 MB (super light)
#    • Speed: ~15-21 tokens/sec on CPU
#    • GPU: Works on 2GB+ GPUs (faster)
#    • Languages: 100+ (Hindi + English)
#    • Install: ollama pull qwen3:0.6b
# ═══════════════════════════════════════════════
AI_ENABLED=true
AI_MODEL=qwen3:0.6b
AI_HOST=http://127.0.0.1:11434
AI_MAX_TOKENS=512
AI_TEMPERATURE=0.7
AI_MENTION_TRIGGER=true
AI_TIMEOUT_SECONDS=90

# ── Alternative Models (upgrade if needed) ──
# AI_MODEL=qwen3:1.7b     → better quality, still fast
# AI_MODEL=qwen3:4b       → great balance
# AI_MODEL=qwen3:8b       → high quality, slower
# AI_MODEL=llama3.2:1b    → Meta's fast model
# AI_MODEL=llama3         → best quality, needs 8GB+ RAM

# ── Payments ──
CURRENCY=INR
CURRENCY_SYMBOL=₹
UPI_ID=
UPI_NAME=InfiniteCore Hosting
PAYMENT_MIN_AMOUNT=1
PAYMENT_MAX_AMOUNT=100000

# ── VPS ──
VPS_DEFAULT_RAM=2048
VPS_DEFAULT_CPU=2
VPS_DEFAULT_DISK=20
VPS_AUTO_EXPIRE_DAYS=30
VPS_MAX_PER_USER=5

# ── Pterodactyl ──
PTERO_PANEL_URL=
PTERO_API_KEY=
PTERO_NODE_ID=1

# ── Minecraft ──
MC_DEFAULT_VERSION=1.20.4
MC_MAX_PER_USER=3
MC_DEFAULT_RAM=2048
MC_DEFAULT_PORT=25565

# ── Moderation ──
AUTOMOD_ENABLED=true
AUTOMOD_BAD_WORDS=
AUTOMOD_SPAM_THRESHOLD=5
AUTOMOD_CAPS_PERCENT=70
AUTOMOD_INVITE_BLOCK=true

# ── Welcome ──
WELCOME_ENABLED=true
WELCOME_MESSAGE=Welcome {user} to **{guild}**! Member #{count}
GOODBYE_ENABLED=true
GOODBYE_MESSAGE={user} left **{guild}**. Now {count} members.

# ── Leveling ──
LEVELING_ENABLED=true
LEVELING_XP_MIN=15
LEVELING_XP_MAX=25
LEVELING_COOLDOWN_SECONDS=60

# ── Database ──
DB_PATH=data/infinitecore.db

# ── UI ──
UI_EMBED_FOOTER=true
UI_TIMESTAMP=true
UI_USE_THUMBNAIL=true
UI_ANIMATION_ENABLED=true
UI_ANIMATION_SPEED=0.6
